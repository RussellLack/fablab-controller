# Supabase — get these from https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Postgres connection — get from Supabase → Settings → Database → Connection string (URI mode, port 6543 for pooling)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Google Workspace domain restriction (only fablab.no can sign in)
# Set this in Supabase Auth → Providers → Google → Additional Scopes / hosted domain
# Not used in code directly; documented here as a reminder for setup

# DeepL Free for Norwegian MT (optional — translation pipeline)
# DEEPL_API_KEY=

# Sentry — runtime error tracking (production only; skip for local dev)
# Get from https://sentry.io → your project → Settings → Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN is exposed to the browser; SENTRY_DSN is server-only (same value, just the naming convention)
# NEXT_PUBLIC_SENTRY_DSN=https://YOUR_KEY@o0.ingest.sentry.io/0
# SENTRY_DSN=https://YOUR_KEY@o0.ingest.sentry.io/0
# Build-time only — for source-map upload during CI/Netlify production builds
# Get from Sentry → Settings → Account → API → Auth Tokens (scope: project:releases + project:read)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=fablab-design
# SENTRY_PROJECT=fablab-controller

# E2E testing (optional — only when running `npm run test:e2e` locally)
# ENABLE_TEST_LOGIN=1 enables the /api/test/login route. NEVER set this in production.
# SUPABASE_SERVICE_ROLE_KEY required by the test-login route to mint test sessions.
# Get from Supabase → Settings → API → service_role key (treat like a password).
# ENABLE_TEST_LOGIN=1
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...

# Public intake endpoint shared secret (server-to-server auth for /api/public/intake)
# The marketing site's /api/onboarding forwarder must send the same value in the
# x-intake-secret header. Generate a long random string and set it here for local dev
# and as an environment variable in Netlify for production. Do NOT commit the real value.
# INTAKE_SHARED_SECRET=
